+## Regression test for issue #2918, the inline script can be passed after "--"
+echo '{"foo":42}' | $VALGRIND $JQ -- .foo > $d/out
+printf '42\n' > $d/expected
+cmp $d/out $d/expected
+# an option-looking filter can be passed after "--"
+$VALGRIND $JQ -n -- -1 > $d/out
+printf '%s\n' -1 > $d/expected
+cmp $d/out $d/expected
+$VALGRIND $JQ -cn --args -- '$ARGS.positional' foo --bar > $d/out
+printf '["foo","--bar"]\n' > $d/expected
+cmp $d/out $d/expected
+
