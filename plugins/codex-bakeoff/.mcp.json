{
  "mcpServers": {
    "codex-bakeoff": {
      "command": "python3",
      "args": [
        "./mcp/server.py"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "CODEX_SQLITE_HOME",
        "CODEX_API_KEY",
        "CODEX_CLI_PATH",
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_PREFERRED_GIT_EXECUTABLE",
        "GIT_CONFIG_SYSTEM",
        "GIT_EXEC_PATH",
        "GIT_TEMPLATE_DIR",
        "OG_GIT_EXECUTABLE",
        "XDG_CACHE_HOME",
        "HOME",
        "PATH",
        "CODEX_BAKEOFF_RUN_ROOT",
        "CODEX_BAKEOFF_CONTROLLER_PORT",
        "CODEX_BAKEOFF_DENIED_HOSTS"
      ],
      "tool_timeout_sec": 300
    }
  }
}
